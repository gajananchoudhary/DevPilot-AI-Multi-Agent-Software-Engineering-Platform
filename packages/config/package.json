{
  "name": "@forgeai/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./ai": {
      "types": "./src/ai.ts",
      "import": "./dist/ai.js"
    },
    "./api": {
      "types": "./src/api.ts",
      "import": "./dist/api.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "import": "./dist/auth.js"
    },
    "./database": {
      "types": "./src/database.ts",
      "import": "./dist/database.js"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "import": "./dist/constants.js"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "import": "./dist/shared.js"
    },
    "./web": {
      "types": "./src/web.ts",
      "import": "./dist/web.js"
    },
    "./worker": {
      "types": "./src/worker.ts",
      "import": "./dist/worker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "zod": "^3.24.1"
  }
}
