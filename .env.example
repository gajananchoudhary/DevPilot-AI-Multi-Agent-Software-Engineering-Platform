OPENAI_EMBEDDING_MODEL=text-embedding-3-large

#################################
# Worker
#################################

WORKER_CONCURRENCY=5
QUEUE_PREFIX=forgeai

#################################
# Feature Flags
#################################

ENABLE_GITHUB=true
ENABLE_ANALYTICS=false
ENABLE_TELEMETRY=false