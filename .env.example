#################################
# Application
#################################

APP_NAME=ForgeAI
APP_ENV=development
APP_VERSION=0.1.0
NODE_ENV=development

#################################
# Frontend
#################################

WEB_PORT=5173
WEB_URL=http://localhost:5173

VITE_API_URL=http://localhost:4000
VITE_APP_NAME=ForgeAI

#################################
# API
#################################

API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173

#################################
# Database
#################################

POSTGRES_DB=forgeai
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=forgeai

DATABASE_URL=postgresql://forgeai:forgeai@localhost:5433/forgeai?schema=public

#################################
# Redis
#################################

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

#################################
# JWT
#################################

JWT_ACCESS_SECRET=4xEJutvf/v1D5v/TFgUA8EmvajPH7oWK/kkj9/tYYPAoM1EZQQ71NfFBlyHdJ68csC739DiIVudDs3+TlzPzD9w==
JWT_REFRESH_SECRET=qV7qaAQeNnT2p/KBFv/LNpB3oOZxIBrNHYh6sBICBcXjlBqun7Cwj1PMna9PEJEWihOdqqRcD3b2AF/hu3WzOg==
