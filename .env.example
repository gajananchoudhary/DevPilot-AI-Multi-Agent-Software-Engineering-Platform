APP_NAME=ForgeAI
APP_ENV=development
APP_VERSION=0.1.0
NODE_ENV=development
LOG_LEVEL=debug

WEB_PORT=5173
WEB_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
VITE_APP_NAME=ForgeAI

API_PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:5173
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

POSTGRES_DB=forgeai
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=forgeai
DATABASE_URL=postgresql://forgeai:forgeai@localhost:5433/forgeai?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=forgeai
JWT_AUDIENCE=forgeai-web

ADMIN_EMAIL=admin@forgeai.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=ForgeAI Administrator

WORKER_CONCURRENCY=5
QUEUE_PREFIX=forgeai
